# ---------------------------------------------------------------------------
# Skopiuj ten plik jako `.env.local` i uzupelnij wartosci.
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Publiczny adres strony. Uzywany w kanonicznych URL-ach, sitemap.xml,
# robots.txt i metadanych Open Graph. BEZ ukosnika na koncu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dostarczanie zgloszen z formularza (OPCJONALNE, ale wymagane na produkcji)
#
# Trasa POST /api/lesson-request waliduje zgloszenie i - jesli ta zmienna jest
# ustawiona - przesyla je jako JSON metoda POST pod podany adres.
# Dziala z dowolnym webhookiem: Make.com, Zapier, n8n, Formspree, Slack,
# Google Apps Script, wlasny endpoint.
#
# Jesli NIE jest ustawiona: zgloszenie zostanie zwalidowane i zapisane w logach
# serwera z ostrzezeniem, a uzytkownik zobaczy komunikat sukcesu. Na produkcji
# oznacza to UTRATE ZGLOSZENIA - ustaw ta zmienna przed publikacja strony.
# ---------------------------------------------------------------------------
LESSON_REQUEST_WEBHOOK_URL=
